// SPDX-License-Identifier: Apache-2.0

// Windows resources of Sarke's executables: the app icon (Explorer, taskbar, Start menu, installer)
// and the version and description shown in the file's properties and in Task Manager. Each target
// defines which executable it is (SARKE_EXE_*).
#include <winver.h>

#include "version.h"

#if defined(SARKE_EXE_HOST)
#define SARKE_DESCRIPTION "Sarke - this PC shares (host)"
#define SARKE_FILE "kvm_host.exe"
#elif defined(SARKE_EXE_CLIENT)
#define SARKE_DESCRIPTION "Sarke - this PC joins (client)"
#define SARKE_FILE "kvm_client.exe"
#elif defined(SARKE_EXE_DRIVER)
#define SARKE_DESCRIPTION "Sarke virtual display setup"
#define SARKE_FILE "sarke_driver.exe"
#else
#define SARKE_DESCRIPTION "Sarke"
#define SARKE_FILE "sarke.exe"
#endif

1 ICON "../docs/brand/sarke.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SARKE_VERSION_COMMA
PRODUCTVERSION SARKE_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sarke"
            VALUE "FileDescription", SARKE_DESCRIPTION
            VALUE "FileVersion", SARKE_VERSION_STRING
            VALUE "InternalName", SARKE_FILE
            VALUE "OriginalFilename", SARKE_FILE
            VALUE "ProductName", "Sarke"
            VALUE "ProductVersion", SARKE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
