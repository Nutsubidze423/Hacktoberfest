{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" }
  ],
  "testPresets": [
    {
      "name": "unit",
      "displayName": "Unit tests (headless, CI)",
      "configurePreset": "x64-release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "^unit$" } },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "local",
      "displayName": "Everything that runs on one PC (unit + desktop + vdd); hands off the mouse",
      "configurePreset": "x64-release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "^(unit|desktop|vdd)$" } },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
