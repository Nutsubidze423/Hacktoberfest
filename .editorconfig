# Editor basics for every file; C++ layout beyond this is .clang-format's job.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,rc,ps1,iss}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake,*.json,*.yml,*.yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
